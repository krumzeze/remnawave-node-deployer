### Панель Remnawave — сгенерировано деплойером, секреты не редактировать вручную
APP_PORT=3000

JWT_AUTH_SECRET={{ panel_jwt_auth_secret }}
JWT_API_TOKENS_SECRET={{ panel_jwt_api_tokens_secret }}

FRONT_END_DOMAIN={{ panel_domain }}
SUB_PUBLIC_DOMAIN={{ panel_domain }}/api/sub

IS_DOCS_ENABLED=false
METRICS_USER=metrics
METRICS_PASS={{ panel_metrics_pass }}

DATABASE_URL=postgresql://remnawave:{{ panel_postgres_password }}@remnawave-db:5432/remnawave
POSTGRES_USER=remnawave
POSTGRES_PASSWORD={{ panel_postgres_password }}
POSTGRES_DB=remnawave

REDIS_HOST=remnawave-redis
REDIS_PORT=6379
