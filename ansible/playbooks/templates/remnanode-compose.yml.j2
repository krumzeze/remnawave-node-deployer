services:
  remnanode:
    image: remnawave/node:latest
    # Фиксируем имя контейнера: reloadcmd в issue_cert.yml перезапускает ноду по
    # имени `remnanode` при автопродлении сертификата. Без этого compose назвал бы
    # контейнер remnanode-remnanode-1 и docker restart не нашёл бы его.
    container_name: remnanode
    hostname: remnanode
    restart: always
    network_mode: host
    cap_add:
      - NET_ADMIN
    ulimits:
      nofile:
        soft: 1048576
        hard: 1048576
    environment:
      # Имена переменных задаёт образ remnawave/node (см. compose, который панель
      # отдаёт при создании ноды): ключ панели — SECRET_KEY, порт — NODE_PORT.
      # Старые SSL_CERT/APP_PORT актуальный образ не читает: контейнер стартует
      # без ключа и на дефолтном порту, и панель не может к нему подключиться.
      SECRET_KEY: "{{ remnanode_secret_key }}"
      NODE_PORT: "{{ remnanode_port }}"
    volumes:
      # Сертификаты acme.sh (TLS-инбаунды, ADR 0005). Каталог есть всегда; для
      # domain-free набора он просто пустой. Пути сертификата в Xray-конфиге
      # указываются относительно точки монтирования внутри контейнера.
      - {{ cert_dir_host | default('/opt/remnanode/certs') }}:{{ cert_dir_container | default('/etc/remnanode/certs') }}:ro
