# --- Telegram ---
BOT_TOKEN=

# Админы бота: Telegram-ID через запятую (например 111,222). Это НЕ барьер
# доступа — регистрация открытая, любой может пользоваться ботом с бесплатным
# тарифом. Админам доступны служебные команды и ручная выдача подписки.
ADMIN_TELEGRAM_IDS=

# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nodeforge
POSTGRES_USER=nodeforge
POSTGRES_PASSWORD=change-me

# --- Redis / arq ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Vault ---
# Боевой Vault с файловым хранилищем (vault/entrypoint.sh). VAULT_TOKEN — это
# токен ПРИЛОЖЕНИЯ: при старте Vault создаёт токен с этим id и политикой только
# на KV-маунт. Root-токен и ключ распечатки сюда не попадают — они генерируются
# при первом запуске и лежат в томе vaultdata (/vault/data/init.json). Задай
# свой длинный случайный токен.
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=change-me-app-token
VAULT_KV_MOUNT=secret

# --- Remnawave panel ---
# Панель у каждого пользователя своя (bring-your-own): её URL и токен он вводит
# в боте, они хранятся per-user (Postgres + Vault). Глобальной панели оператора
# больше нет — чужая нода не должна попадать в неё под токеном оператора.

# Каталог на хосте деплойера для файлов стека панели при локальном разворачивании
# (placement=local). Пусто = дефолт /opt/remnawave-panel. Для vps не используется.
PANEL_LOCAL_DIR=

# Сценарий «развернуть панель с нуля» временно отключён, пока не проверен на
# живом сервере: кнопка в боте скрыта. Поставить true, чтобы вернуть.
PANEL_FROM_SCRATCH_ENABLED=false

# --- Web dashboard ---
WEB_HOST=0.0.0.0
WEB_PORT=8000

# Публичный базовый URL дашборда — из него бот собирает персональную ссылку
# (команда /dashboard). Пусто = ссылку не показываем.
WEB_BASE_URL=

# Секрет подписи токенов доступа к дашборду. Веб пускает только по подписанному
# ботом токену, а не по сырому Telegram-ID. Пусто = веб-API отдаёт 503. Задай
# свой длинный случайный секрет.
WEB_SECRET=change-me-web-secret
