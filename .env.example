# --- Telegram ---
BOT_TOKEN=

# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nodeforge
POSTGRES_USER=nodeforge
POSTGRES_PASSWORD=change-me

# --- Redis / arq ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Vault ---
# Боевой Vault с файловым хранилищем (vault/entrypoint.sh). VAULT_TOKEN — это
# токен ПРИЛОЖЕНИЯ: при старте Vault создаёт токен с этим id и политикой только
# на KV-маунт. Root-токен и ключ распечатки сюда не попадают — они генерируются
# при первом запуске и лежат в томе vaultdata (/vault/data/init.json). Задай
# свой длинный случайный токен.
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=change-me-app-token
VAULT_KV_MOUNT=secret

# --- Remnawave panel (для bring-your-own-panel это задаёт пользователь) ---
REMNAWAVE_PANEL_URL=https://panel.harek.uk
REMNAWAVE_API_TOKEN=

# --- Web dashboard ---
WEB_HOST=0.0.0.0
WEB_PORT=8000
